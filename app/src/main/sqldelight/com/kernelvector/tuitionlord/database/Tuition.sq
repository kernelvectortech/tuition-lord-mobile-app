CREATE TABLE student (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    monthly_rate INTEGER NOT NULL,
    cycle_length_sessions INTEGER NOT NULL DEFAULT 12,
    student_phone TEXT,
    guardian_name TEXT,
    guardian_phone TEXT,
    address TEXT,
    subject TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    is_archived INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE cycle (
    id TEXT NOT NULL PRIMARY KEY,
    student_id TEXT NOT NULL REFERENCES student(id),
    idx INTEGER NOT NULL,
    start_date TEXT NOT NULL,
    target_sessions INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'ACTIVE'
        CHECK (status IN ('ACTIVE', 'SETTLED')),
    settled_at TEXT,
    updated_at TEXT NOT NULL,
    UNIQUE (student_id, idx)
);

CREATE TABLE class_day (
    id TEXT NOT NULL PRIMARY KEY,
    student_id TEXT NOT NULL REFERENCES student(id),
    cycle_id TEXT REFERENCES cycle(id),
    date TEXT NOT NULL,
    slot INTEGER NOT NULL DEFAULT 1,
    status TEXT NOT NULL DEFAULT 'SCHEDULED'
        CHECK (status IN ('SCHEDULED', 'HELD', 'NOT_HELD')),
    source TEXT NOT NULL
        CHECK (source IN ('markToday', 'yesterday', 'tomorrow', 'calendar', 'fromReminder')),
    note TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    UNIQUE (student_id, date, slot)
);

CREATE TABLE student_schedule (
    id TEXT NOT NULL PRIMARY KEY,
    student_id TEXT NOT NULL REFERENCES student(id),
    day_of_week TEXT NOT NULL
        CHECK (day_of_week IN ('MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN')),
    start_time TEXT NOT NULL,
    duration INTEGER NOT NULL,
    updated_at TEXT NOT NULL,
    UNIQUE (student_id, day_of_week)
);

CREATE TABLE settlement (
    id TEXT NOT NULL PRIMARY KEY,
    student_id TEXT NOT NULL REFERENCES student(id),
    cycle_id TEXT NOT NULL UNIQUE REFERENCES cycle(id),
    sessions_counted INTEGER NOT NULL,
    amount INTEGER NOT NULL,
    payment_status TEXT NOT NULL DEFAULT 'DUE'
        CHECK (payment_status IN ('DUE', 'COLLECTED', 'PARTIALLY_COLLECTED')),
    collected_at TEXT,
    settled_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    note TEXT
);

CREATE INDEX idx_cycle_student ON cycle(student_id);
CREATE INDEX idx_class_day_cycle ON class_day(cycle_id);
CREATE INDEX idx_class_day_student ON class_day(student_id);
CREATE INDEX idx_student_schedule_student ON student_schedule(student_id);
CREATE INDEX idx_settlement_student ON settlement(student_id);
CREATE INDEX idx_settlement_cycle ON settlement(cycle_id);

getActiveStudents:
SELECT * FROM student
WHERE is_archived = 0
ORDER BY name;

getStudentById:
SELECT * FROM student
WHERE id = ?;

insertStudent:
INSERT INTO student (
    id, name, monthly_rate, cycle_length_sessions, student_phone,
    guardian_name, guardian_phone, address, subject,
    created_at, updated_at, is_archived
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

archiveStudent:
UPDATE student
SET is_archived = 1, updated_at = ?
WHERE id = ?;