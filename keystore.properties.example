# Keystore configuration template for release signing
# DO NOT COMMIT the actual keystore.properties file to git
# Copy this file to keystore.properties and fill in the actual values
#
# To generate a release keystore:
#   keytool -genkey -v -keystore tuition-lord-release.jks -alias tuition_lord_key \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the paths and passwords below:

storeFile=path/to/tuition-lord-release.jks
storePassword=your_keystore_password
keyAlias=tuition_lord_key
keyPassword=your_key_password
